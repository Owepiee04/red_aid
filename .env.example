# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the Add Account route (src/app/api/admin/accounts/route.ts).
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the app, used in email links (confirm sign-up, reset password).
# Local: http://localhost:3000   Vercel: https://<your-app>.vercel.app (set it in Vercel, not here).
# Optional: without it the app uses the address the browser is on.
REDIRECT_URL=http://localhost:3000

# Server-only. Protects the daily cleanup job (src/app/api/cron/cleanup-exported):
# Vercel sends it automatically when this is set in Vercel. Any long random string.
CRON_SECRET=
